# Movie Agent MCP — Root Environment Variables
# Copy this file to .env and fill in the values.
# These are read by docker-compose.yml and passed to the appropriate services.

# TMDB API key — used by the MCP server to call the TMDB REST API.
# Get one at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Google Gemini API key — used by the agent backend for LLM inference.
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
