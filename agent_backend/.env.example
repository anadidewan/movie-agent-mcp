# Agent Backend — environment variables
# Copy this file to .env and fill in the values

# Required: Google Gemini API key
GEMINI_API_KEY=

# Required: Base URL of the MCP wrapper microservice
MCP_BASE_URL=http://localhost:3000

# Optional: Allowed frontend origin for CORS (default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173

# Optional: Service version string (default: 0.1.0)
VERSION=0.1.0

# Optional: Log level — DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
